// Prisma schema for PerBlinkist

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String   @id @default(cuid())
  username             String   @unique
  email                String?  @unique
  passwordHash         String
  isAdmin              Boolean  @default(false)

  // Password Recovery via Security Question
  securityQuestion     String?
  securityAnswerHash   String?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model BookSummary {
  id              String    @id @default(cuid())
  filePath        String    @unique // Relative or absolute path to audio file in /media
  fileHash        String?   // Signature hash
  fileSize        Int?      // Size in bytes
  fileMtime       DateTime? // Last modified timestamp of physical audio file
  fileName        String    // Original file name (e.g. "The Talent Code (Daniel Coyle).mka")
  format          String?   // Audio format/container (e.g. "mka", "mp3")
  codec           String?   // Codec (e.g. "OPUS", "AAC")
  bitrate         Int?      // Bitrate in bps
  isMissing       Boolean   @default(false) // True if file disappeared from mounted volume

  // Embedded audio tags from file
  embeddedTitle   String?
  embeddedAuthor  String?

  // Metadata extracted or fetched from Google Books / Open Library
  title           String
  author          String?
  durationSeconds Float?    // Audio duration in seconds
  coverUrl        String?   // Remote cover URL
  localCoverPath  String?   // Path to cached image in /config/cache/covers
  synopsis        String?   // Book description/summary
  category        String?   // Primary genre / category (e.g. Productivity, Psychology)
  publisher       String?
  publishedYear   Int?
  isbn            String?

  // Ingestion & Enrichment status
  matchedSource   String?   // "google_books", "open_library", or "fallback"
  isEnriched      Boolean   @default(false)
  indexingStatus  String    @default("indexed") // "indexed"
  enrichmentStatus String   @default("pending") // "pending" | "enriched" | "rate_limited" | "failed" | "skipped"
  enrichmentError String?   // Diagnostics message (e.g., "HTTP 429: Rate limit reached")
  enrichedAt      DateTime? // Timestamp when metadata was enriched
  retryCount      Int       @default(0)         // Number of enrichment retry attempts

  // Playback state
  playbackPosition Float    @default(0) // Last playback timestamp in seconds
  isCompleted      Boolean  @default(false)
  lastPlayedAt     DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([title])
  @@index([author])
  @@index([category])
  @@index([isMissing])
  @@index([enrichmentStatus])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
